# ─── Required ──────────────────────────────────────────────────────────────
# Postgres (Neon via the Vercel Marketplace recommended). Pooled URL for the app:
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Direct (unpooled) URL for migrations — Neon's integration sets this automatically:
DATABASE_URL_UNPOOLED=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the deployment (e.g. https://feedbeat.app). Defaults to NEXT_PUBLIC_SITE_URL.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Sign-in (free) — configure at least one ────────────────────────────────
# GitHub: github.com/settings/developers → OAuth App. Callback: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: console.cloud.google.com → Credentials → OAuth client. Redirect: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── X API (PAID, optional) ───────────────────────────────────────────────
# Leave empty for the free setup: users import their own X archive instead.
# With a token, anyone can scan any public handle (≈ $0.005 per post read).
X_BEARER_TOKEN=
# "Sign in with X" also makes paid API calls. Callback: {BETTER_AUTH_URL}/api/auth/callback/twitter
X_CLIENT_ID=
X_CLIENT_SECRET=
# Max posts read per scan (100–3200).
SCAN_MAX_TWEETS=800

# ─── Optional ──────────────────────────────────────────────────────────────
# "Save to Spotify". Callback: {BETTER_AUTH_URL}/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Upstash Redis (Vercel Marketplace) for distributed rate limiting.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Protects /api/cron/refresh (Vercel sends it automatically for crons).
CRON_SECRET=

# Force demo data even when X_BEARER_TOKEN is set (true/false).
DEMO_MODE=false

GOOGLE_SITE_VERIFICATION=
